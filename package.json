{
  "name": "levelarc",
  "version": "1.1.3",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.4",
    "expo-build-properties": "~56.0.16",
    "expo-constants": "~56.0.15",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.11",
    "expo-notifications": "~56.0.13",
    "expo-router": "~56.2.6",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.16",
    "llama.rn": "0.12.4",
    "lucide-react-native": "^1.16.0",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "^0.2.4",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~56.0.12",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "doctor": "npx expo-doctor",
    "db:generate": "drizzle-kit generate",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "update:preview": "npx eas-cli update --channel preview --environment preview",
    "update:production": "npx eas-cli update --channel production --environment production"
  },
  "private": true,
  "knip": {
    "ignore": [
      "docs/UI-UX/**"
    ],
    "ignoreDependencies": [
      "@babel/plugin-transform-react-jsx"
    ]
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "llama.rn"
    ],
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ],
    "patchedDependencies": {
      "llama.rn@0.12.4": "patches/llama.rn@0.12.4.patch"
    }
  },
  "packageManager": "pnpm@10.33.3"
}
